          "$type": "string",
          "$value": "square"
        },
        "icon": {
          "$type": "string",
          "$value": "i-in-square"
        },
        "label": {
          "$type": "string",
          "$value": "INFO"
        },
        "severity": {
          "$type": "number",
          "$value": 1
        },
        "condition": {
          "$type": "string",
          "$value": "Informational. No operator action is implied."
        },
        "threshold-source": {
          "$type": "string",
          "$value": "NOT_APPLICABLE"
        }
      },
      "caution": {
        "color": {
          "$type": "color",
          "$value": "#F59E0B",
          "$description": "Sheet: Warning. Renamed caution to avoid confusion with the 'warning' UI pattern.",
          "$extensions": {
            "loom": {
              "provenance": "source"
            }
          }
        },
        "shape": {
          "$type": "string",
          "$value": "triangle"
        },
        "icon": {
          "$type": "string",
          "$value": "exclamation-in-triangle"
        },
        "label": {
          "$type": "string",
          "$value": "CAUTION"
        },
        "severity": {
          "$type": "number",
          "$value": 2
        },
        "condition": {
          "$type": "string",
          "$value": "A defined limit is being approached or a margin is reduced. Monitor, and act if it continues."
        },
        "threshold-source": {
          "$type": "string",
          "$value": "UNDEFINED"
        }
      },
      "critical": {
        "color": {
          "$type": "color",
          "$value": "#EF4444",
          "$description": "Sheet: Danger.",
          "$extensions": {
            "loom": {
              "provenance": "source"
            }
          }
        },
        "shape": {
          "$type": "string",
          "$value": "octagon"
