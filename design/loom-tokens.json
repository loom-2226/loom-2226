{
  "$description": "LOOM design tokens (DRAFT v0.1.0), single file. Top-level groups are the three layers: brand, interface, domain. Format follows the W3C Design Tokens (DTCG) draft; loom metadata is under $extensions.loom. Provenance vocabulary: source | observed | derived | proposed. Layer rule: brand references nothing; interface references brand; domain references brand and interface. $manifest holds version, approval status, asset list and machine checks.",
  "$manifest": {
    "name": "LOOM Design System",
    "id": "loom-design-system",
    "version": "0.1.0-draft",
    "status": "DRAFT",
    "approval": {
      "approved": false,
      "approved_by": null,
      "approved_on": null,
      "approved_version": null,
      "rule": "Status stays DRAFT until the owner records approval here. Once approved, brand-layer token values, logo geometry and Montserrat roles are frozen: changes need an explicit owner-approved version bump (see LOOM_STYLE_GUIDE section 8)."
    },
    "identity": {
      "wordmark": "LOOM",
      "tagline": "A BRIGHTER UNIVERSE CONNECTS US",
      "supporting_lines": [
        "A COHERENT UNIVERSE. A CLEARER TOMORROW.",
        "FURTHER TOGETHER",
        "CIVILIZATION BEYOND BORDERS",
        "SAME STARS. A RICHER TOMORROW."
      ],
      "sheet_keywords": [
        "PEOPLE",
        "PLACES",
        "SYSTEMS",
        "A BRIGHTER TOMORROW"
      ],
      "product_lockups": [
        "LOOM / ATLAS"
      ],
      "abstract": "LOOM is a hard-science-fiction worldbuilding and systems platform centered on human civilization expanding across the Solar System. It combines navigation, atlas, infrastructure, economic, and societal views into a coherent future-operating picture."
    },
    "layers": {
      "brand": {
        "may_reference": []
      },
      "interface": {
        "may_reference": [
          "brand"
        ]
      },
      "domain": {
        "may_reference": [
          "brand",
          "interface"
        ]
      }
    },
    "provenance_vocabulary": {
      "source": "Read directly from the brand sheet.",
      "observed": "Seen in the brand sheet or Ceres Atlas mock but not specified as a rule.",
      "derived": "Computed from source values (for example an alpha variant of a brand colour).",
      "proposed": "New in this system. Needs owner approval."
    },
    "sources": [],
    "assets": {
      "logo": [
        "loom-wordmark-white.svg",
        "loom-wordmark-void.svg",
        "loom-mark-ion-blue.svg"
      ]
    },
    "fonts": {
      "family": "Montserrat",
      "license": "SIL Open Font License 1.1",
      "weights_used": [
        200,
        300,
        400,
        500
      ],
      "css": "loom-tokens.css",
      "files": [
        "Montserrat-VF.woff2"
      ],
      "bundled": false,
      "note": "Font binary not bundled. See LOOM_STYLE_GUIDE.md Appendix B."
    },
    "generated": [
      "loom-tokens.css"
    ],
    "checks": {
      "cvd_min_delta_e_warn": 20,
      "contrast": [
        {
          "use": "text on every surface",
          "fg": "interface.text.primary",
          "bg": [
            "interface.surface.canvas",
            "interface.surface.panel",
            "interface.surface.raised",
            "interface.surface.control",
            "interface.surface.highest"
          ],
          "min": 4.5
        },
        {
          "use": "secondary text",
          "fg": "interface.text.secondary",
          "bg": [
            "interface.surface.canvas",
            "interface.surface.panel",
            "interface.surface.raised",
            "interface.surface.control",
            "interface.surface.highest"
          ],
          "min": 4.5
        },
        {
          "use": "tertiary text (not on highest)",
          "fg": "interface.text.tertiary",
          "bg": [
            "interface.surface.canvas",
            "interface.surface.panel",
            "interface.surface.raised",
            "interface.surface.control"
          ],
          "min": 4.5
        },
        {
          "use": "labels, values, links",
          "fg": "interface.text.label",
          "bg": [
            "interface.surface.canvas",
            "interface.surface.panel",
            "interface.surface.raised",
            "interface.surface.control",
            "interface.surface.highest"
          ],
          "min": 4.5
        },
        {
          "use": "hero metric",
          "fg": "interface.text.hero-metric",
          "bg": [
            "interface.surface.canvas",
            "interface.surface.panel",
            "interface.surface.raised",
            "interface.surface.control",
            "interface.surface.highest"
          ],
          "min": 4.5
        },
        {
          "use": "text on solid ion-blue",
          "fg": "interface.text.on-accent",
          "bg": [
            "brand.color.accent.ion-blue"
          ],
          "min": 4.5
        },
        {
          "use": "status text (nominal)",
          "fg": "domain.status.nominal.color",
          "bg": [
            "interface.surface.canvas",
            "interface.surface.panel",
            "interface.surface.raised",
            "interface.surface.control",
            "interface.surface.highest"
          ],
          "min": 4.5
        },
        {
          "use": "status text (info)",
          "fg": "domain.status.info.color",
          "bg": [
            "interface.surface.canvas",
            "interface.surface.panel",
            "interface.surface.raised",
            "interface.surface.control",
            "interface.surface.highest"
          ],
          "min": 4.5
        },
        {
          "use": "status text (caution)",
          "fg": "domain.status.caution.color",
          "bg": [
            "interface.surface.canvas",
            "interface.surface.panel",
            "interface.surface.raised",
            "interface.surface.control",
            "interface.surface.highest"
          ],
          "min": 4.5
        },
        {
          "use": "status text (critical, canvas/panel/raised only)",
          "fg": "domain.status.critical.color",
          "bg": [
            "interface.surface.canvas",
            "interface.surface.panel",
            "interface.surface.raised"
          ],
          "min": 4.5
        },
        {
          "use": "status graphics (critical on control/highest)",
          "fg": "domain.status.critical.color",
          "bg": [
            "interface.surface.control",
            "interface.surface.highest"
          ],
          "min": 3.0
        },
        {
          "use": "selection ring",
          "fg": "domain.selection.highlight",
          "bg": [
            "interface.surface.canvas",
            "interface.surface.panel",
            "interface.surface.raised",
            "interface.surface.control",
            "interface.surface.highest"
          ],
          "min": 3.0
        },
        {
          "use": "focus ring",
          "fg": "interface.focus.ring-color",
          "bg": [
            "interface.surface.canvas",
            "interface.surface.panel",
            "interface.surface.raised",
            "interface.surface.control",
            "interface.surface.highest"
          ],
          "min": 3.0
        },
        {
          "use": "certainty text (canvas/panel/raised)",
          "fg": "domain.certainty.provisional.color",
          "bg": [
            "interface.surface.canvas",
            "interface.surface.panel",
            "interface.surface.raised"
          ],
          "min": 4.5
        },
        {
          "use": "certainty text (canvas/panel/raised)",
          "fg": "domain.certainty.estimated.color",
          "bg": [
            "interface.surface.canvas",
            "interface.surface.panel",
            "interface.surface.raised"
          ],
          "min": 4.5
        },
        {
          "use": "certainty text (canvas/panel/raised)",
          "fg": "domain.certainty.unresolved.color",
          "bg": [
            "interface.surface.canvas",
            "interface.surface.panel",
            "interface.surface.raised"
          ],
          "min": 4.5
        },
        {
          "use": "navigation strokes",
          "fg": "domain.nav.orbit.color",
          "bg": [
            "interface.surface.canvas",
            "interface.surface.panel"
          ],
          "min": 3.0
        },
        {
          "use": "navigation strokes",
          "fg": "domain.nav.route-planned.color",
          "bg": [
            "interface.surface.canvas",
            "interface.surface.panel"
          ],
          "min": 3.0
        },
        {
          "use": "navigation strokes",
          "fg": "domain.nav.route-alternate.color",
          "bg": [
            "interface.surface.canvas",
            "interface.surface.panel"
          ],
          "min": 3.0
        },
        {
          "use": "navigation strokes",
          "fg": "domain.nav.route-completed.color",
          "bg": [
            "interface.surface.canvas",
            "interface.surface.panel"
          ],
          "min": 3.0
        },
        {
          "use": "keep-out outline",
          "fg": "domain.nav.keep-out.color",
          "bg": [
            "interface.surface.canvas",
            "interface.surface.panel"
          ],
          "min": 3.0
        }
      ]
    },
    "original_sources_note": "Brand sheet and Ceres Atlas mock are the owner's original images; they are not part of this bundle. Keep the originals.",
    "files": {
      "LOOM_STYLE_GUIDE.md": "Human/agent-readable rules and rationale",
      "loom-tokens.json": "This file: manifest ($manifest) plus all design tokens (brand, interface, domain)",
      "loom-tokens.css": "GENERATED CSS custom properties, type classes, @font-face",
      "loom_design.py": "Python adapter, validator and CSS generator in one stdlib-only file",
      "loom-wordmark-white.svg": "Default logo, for dark backgrounds",
      "loom-wordmark-void.svg": "Logo for light backgrounds",
      "loom-mark-ion-blue.svg": "Segmented-O mark"
    }
  },
  "brand": {
    "color": {
      "$type": "color",
      "primary": {
        "$description": "Background / UI base. A deep cinematic backdrop that lets key elements and data stand out.",
        "$extensions": {
          "loom": {
            "provenance": "source"
          }
        },
        "void": {
          "$value": "#05070B",
          "$description": "Deepest backdrop. Default page canvas."
        },
        "deep-space": {
          "$value": "#0B1220",
          "$description": "Primary panel surface."
        },
        "midnight": {
          "$value": "#11182B",
          "$description": "Raised panel / grouped content."
        },
        "slate": {
          "$value": "#1E2A3A",
          "$description": "Controls and inset regions."
        },
        "nebula": {
          "$value": "#22364A",
          "$description": "Highest-elevation surface; active control fill."
        }
      },
      "accent": {
        "$description": "Pops / interactives. High-energy identity and action colours. NOT operational status colours; see the domain layer.",
        "$extensions": {
          "loom": {
            "provenance": "source"
          }
        },
        "ion-blue": {
          "$value": "#00D1FF",
          "$description": "Primary interactive and label colour. Selection, links, focus."
        },
        "amber": {
          "$value": "#FF8703",
          "$description": "Identity accent for hero metrics. Never use where it could read as caution (see LOOM_STYLE_GUIDE D1)."
        },
        "crimson": {
          "$value": "#FF3B3B",
          "$description": "Identity accent. Not a status colour; status danger is domain.status.critical."
        },
        "violet": {
          "$value": "#B96BFF",
          "$description": "Secondary interactive accent (alternates, comparison series)."
        },
        "emerald": {
          "$value": "#00E676",
          "$description": "Identity accent. Not a status colour; status success is domain.status.nominal."
        }
      },
      "secondary": {
        "$description": "Support / states. Text, icons, supporting UI and environmental detail; adds warmth without competing with accents.",
        "$extensions": {
          "loom": {
            "provenance": "source"
          }
        },
        "steel": {
          "$value": "#8A97A6",
          "$description": "Tertiary text, quiet icons, unresolved data."
        },
        "ice": {
          "$value": "#C7D3DF",
          "$description": "Secondary text and icons."
        },
        "sand": {
          "$value": "#D6B98A",
          "$description": "Warm neutral. Provisional data."
        },
        "copper": {
          "$value": "#C47F46",
          "$description": "Warm support colour for environmental / infrastructure detail."
        },
        "mint": {
          "$value": "#7EE7D1",
          "$description": "Cool support colour for environmental detail. Not a status colour."
        }
      },
      "neutral": {
        "$extensions": {
          "loom": {
            "provenance": "observed"
          }
        },
        "white": {
          "$value": "#FFFFFF",
          "$description": "Logo colour on dark and primary text. Observed in the logo and Ceres Atlas mock; not listed on the palette sheet (see LOOM_STYLE_GUIDE D6)."
        }
      }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "$extensions": {
          "loom": {
            "provenance": "source"
          }
        },
        "primary": {
          "$value": [
            "Montserrat",
            "Avenir Next",
            "Segoe UI",
            "Roboto",
            "system-ui",
            "sans-serif"
          ],
          "$description": "Montserrat is the only brand typeface. Fallbacks are for load failure only (Roboto covers Android/Termux WebView)."
        }
      },
      "weight": {
        "$type": "fontWeight",
        "$extensions": {
          "loom": {
            "provenance": "source"
          }
        },
        "extralight": {
          "$value": 200,
          "$description": "Display / hero."
        },
        "light": {
          "$value": 300,
          "$description": "Section / subhead."
        },
        "regular": {
          "$value": 400,
          "$description": "Body copy."
        },
        "medium": {
          "$value": 500,
          "$description": "Labels, navigation, UI emphasis."
        }
      },
      "tracking": {
        "$type": "dimension",
        "$extensions": {
          "loom": {
            "provenance": "source"
          }
        },
        "display": {
          "$value": "0.2em",
          "$description": "Sheet value +200 (1/1000 em). Display / hero."
        },
        "subhead": {
          "$value": "0.1em",
          "$description": "Sheet value +100. Section / subhead."
        },
        "label": {
          "$value": "0.08em",
          "$description": "Sheet value +80. Labels, navigation, data labels."
        },
        "body": {
          "$value": "0em",
          "$description": "Body copy is not tracked."
        }
      },
      "role": {
        "$description": "Brand typographic roles exactly as specified on the brand sheet. Sizes are an interface-layer decision.",
        "$extensions": {
          "loom": {
            "provenance": "source"
          }
        },
        "display": {
          "weight": {
            "$type": "fontWeight",
            "$value": "{brand.font.weight.extralight}"
          },
          "tracking": {
            "$type": "dimension",
            "$value": "{brand.font.tracking.display}"
          },
          "transform": {
            "$type": "string",
            "$value": "uppercase"
          }
        },
        "subhead": {
          "weight": {
            "$type": "fontWeight",
            "$value": "{brand.font.weight.light}"
          },
          "tracking": {
            "$type": "dimension",
            "$value": "{brand.font.tracking.subhead}"
          },
          "transform": {
            "$type": "string",
            "$value": "uppercase"
          }
        },
        "body": {
          "weight": {
            "$type": "fontWeight",
            "$value": "{brand.font.weight.regular}"
          },
          "tracking": {
            "$type": "dimension",
            "$value": "{brand.font.tracking.body}"
          },
          "transform": {
            "$type": "string",
            "$value": "none"
          }
        },
        "label": {
          "weight": {
            "$type": "fontWeight",
            "$value": "{brand.font.weight.medium}"
          },
          "tracking": {
            "$type": "dimension",
            "$value": "{brand.font.tracking.label}"
          },
          "transform": {
            "$type": "string",
            "$value": "uppercase"
          }
        }
      }
    },
    "logo": {
      "$description": "Logo construction and usage limits. Measured from the brand sheet; see LOOM_STYLE_GUIDE section 2.2.",
      "$extensions": {
        "loom": {
          "provenance": "proposed"
        }
      },
      "min-width-wordmark": {
        "$type": "dimension",
        "$value": "96px",
