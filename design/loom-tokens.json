  "domain": {
    "status": {
      "$description": "Operational status registry. Each entry binds a colour to a defined condition plus redundant non-colour indicators. Threshold values are NOT defined here: each producing system must cite the governing specification for its own thresholds (threshold-source). Provenance: colours are 'source' (brand sheet semantic row); shapes, icons, labels, severities and conditions are 'proposed'.",
      "$extensions": {
        "loom": {
          "provenance": "proposed"
        }
      },
      "nominal": {
        "color": {
          "$type": "color",
          "$value": "#22C55E",
          "$description": "Sheet: Success.",
          "$extensions": {
            "loom": {
              "provenance": "source"
            }
          }
        },
        "shape": {
          "$type": "string",
          "$value": "circle"
        },
        "icon": {
          "$type": "string",
          "$value": "check-in-circle"
        },
        "label": {
          "$type": "string",
          "$value": "NOMINAL"
        },
        "severity": {
          "$type": "number",
          "$value": 0
        },
        "condition": {
          "$type": "string",
          "$value": "The value or system state is inside its defined nominal envelope."
        },
        "threshold-source": {
          "$type": "string",
          "$value": "UNDEFINED"
        }
      },
      "info": {
        "color": {
          "$type": "color",
          "$value": "#38BDF8",
          "$description": "Sheet: Info.",
          "$extensions": {
            "loom": {
