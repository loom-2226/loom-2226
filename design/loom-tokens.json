      },
      "min-size-mark": {
        "$type": "dimension",
        "$value": "16px",
        "$description": "Smallest mark size on screen."
      },
      "clear-space-ratio": {
        "$type": "number",
        "$value": 0.5,
        "$description": "Clear space on all sides = 0.5 x wordmark height (half the O diameter)."
      }
    }
  },
